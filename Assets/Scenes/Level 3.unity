--- !u!114 &1697440868
MonoBehaviour:
  m_ObjectHideFlags: 0
  m_CorrespondingSourceObject: {fileID: 0}
  m_PrefabInstance: {fileID: 0}
  m_PrefabAsset: {fileID: 0}
  m_GameObject: {fileID: 1697440867}
  m_Enabled: 1
  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: 112c05343c1014c7abf5e48d01901320, type: 3}
  m_Name: 
  m_EditorClassIdentifier: 
  grid: {fileID: 460038904}
  characterPrefab: {fileID: 2856711316143925802, guid: 7334558b278687044af349ec44026f21, type: 3}
  targetPrefabs:
  - {fileID: 7065346455924041694, guid: cd920d9b3707fa2408959948feb6208a, type: 3}
  - {fileID: 7923075081395553336, guid: c0d87cedd0c8fec4ea4d3120fca99538, type: 3}
  - {fileID: 5046962144118384475, guid: 48a10e2e11e6a6f49b39830eaac973fa, type: 3}
  targetYOffset: 0
  start: {x: 0, y: 0}
  targetCells:
  - {x: 3, y: 2}
  - {x: 5, y: 6}
  - {x: 2, y: 7}
  levelIntro:
    levelId: 3
    title: "\u0423\u0440\u043E\u0432\u0435\u043D\u044C 3. \u041F\u043E\u0441\u043B\u0435\u0434\u043D\u044F\u044F
      \u043C\u0438\u043B\u044F "
    body: "\u0422\u044B \u043F\u0440\u043E\u0448\u0451\u043B \u0441\u0435\u0442\u044C
      \u043F\u0440\u043E\u0432\u0430\u0439\u0434\u0435\u0440\u0430 \u0438 \u0442\u0435\u043F\u0435\u0440\u044C
      \u043F\u0440\u0438\u0431\u043B\u0438\u0436\u0430\u0435\u0448\u044C\u0441\u044F
      \u043A \u0430\u0431\u043E\u043D\u0435\u043D\u0442\u0443. \u042D\u0442\u043E\u0442
      \u0443\u0447\u0430\u0441\u0442\u043E\u043A \u043D\u0430\u0437\u044B\u0432\u0430\u0435\u0442\u0441\u044F
      \xAB\u043F\u043E\u0441\u043B\u0435\u0434\u043D\u044F\u044F \u043C\u0438\u043B\u044F\xBB
      \u2014 \u043F\u0443\u0442\u044C \u043E\u0442 \u0438\u043D\u0444\u0440\u0430\u0441\u0442\u0440\u0443\u043A\u0442\u0443\u0440\u044B
      \u043F\u0440\u043E\u0432\u0430\u0439\u0434\u0435\u0440\u0430 \u0434\u043E \u043A\u043E\u043D\u043A\u0440\u0435\u0442\u043D\u043E\u0433\u043E
      \u0437\u0434\u0430\u043D\u0438\u044F \u0438 \u043A\u0432\u0430\u0440\u0442\u0438\u0440\u044B.
      \u0417\u0432\u0443\u0447\u0438\u0442 \u043F\u0440\u043E\u0441\u0442\u043E,
      \u043D\u043E \u0438\u043C\u0435\u043D\u043D\u043E \u0437\u0434\u0435\u0441\u044C
      \u0447\u0430\u0449\u0435 \u0432\u0441\u0435\u0433\u043E \u0447\u0442\u043E-\u0442\u043E
      \u0438\u0434\u0451\u0442 \u043D\u0435 \u0442\u0430\u043A.\r\n\r\n\u041D\u0430
      \u044D\u0442\u043E\u043C \u0443\u0440\u043E\u0432\u043D\u0435 \u043F\u043E\u044F\u0432\u043B\u044F\u0435\u0442\u0441\u044F
      \u043D\u043E\u0432\u0430\u044F \u043E\u043F\u0430\u0441\u043D\u043E\u0441\u0442\u044C
      \u2014 \u0437\u043E\u043D\u044B \u043F\u043E\u0442\u0435\u0440\u0438 \u043F\u0430\u043A\u0435\u0442\u043E\u0432.
      \u0412 \u0440\u0435\u0430\u043B\u044C\u043D\u044B\u0445 \u0441\u0435\u0442\u044F\u0445
      \u043F\u0430\u043A\u0435\u0442\u044B \u0438\u043D\u043E\u0433\u0434\u0430 \u043F\u0440\u043E\u0441\u0442\u043E
      \u0438\u0441\u0447\u0435\u0437\u0430\u044E\u0442: \u043A\u0430\u0431\u0435\u043B\u044C
      \u043F\u043E\u0432\u0440\u0435\u0436\u0434\u0451\u043D, \u043A\u0430\u043D\u0430\u043B
      \u043F\u0435\u0440\u0435\u0433\u0440\u0443\u0436\u0435\u043D, \u0441\u0438\u0433\u043D\u0430\u043B
      \u0441\u043B\u0430\u0431\u044B\u0439, \u0434\u0432\u0430 \u043F\u0430\u043A\u0435\u0442\u0430
      \u0441\u0442\u043E\u043B\u043A\u043D\u0443\u043B\u0438\u0441\u044C \u043D\u0430
      \u043E\u0434\u043D\u043E\u043C \u0443\u0447\u0430\u0441\u0442\u043A\u0435 \u0441\u0435\u0442\u0438.
      \u0412 \u0438\u0433\u0440\u0435 \u044D\u0442\u0438 \u0437\u043E\u043D\u044B
      \u043E\u0431\u043E\u0437\u043D\u0430\u0447\u0435\u043D\u044B \u043A\u0430\u043A
      \u044F\u043C\u044B \u2014 \u043F\u0440\u043E\u0432\u0430\u043B\u044B \u0432
      \u043F\u043E\u043B\u0435. \u041F\u043E\u043F\u0430\u043B \u0432 \u044F\u043C\u0443
      \u2014 \u043F\u0430\u043A\u0435\u0442 \u043F\u043E\u0442\u0435\u0440\u044F\u043D,
      \u0438 \u0442\u0435\u0431\u0435 \u043F\u0440\u0438\u0434\u0451\u0442\u0441\u044F
      \u043D\u0430\u0447\u0438\u043D\u0430\u0442\u044C \u0437\u0430\u043D\u043E\u0432\u043E
      \u0441 \u043F\u043E\u0441\u043B\u0435\u0434\u043D\u0435\u0433\u043E \u0447\u0435\u043A\u043F\u043E\u0438\u043D\u0442\u0430.
      \u0412 \u0440\u0435\u0430\u043B\u044C\u043D\u043E\u0439 \u0436\u0438\u0437\u043D\u0438
      TCP \u0438\u043C\u0435\u043D\u043D\u043E \u0442\u0430\u043A \u0438 \u0440\u0430\u0431\u043E\u0442\u0430\u0435\u0442:
      \u043F\u0440\u0438 \u043F\u043E\u0442\u0435\u0440\u0435 \u043F\u0430\u043A\u0435\u0442\u0430
      \u043E\u0442\u043F\u0440\u0430\u0432\u043B\u044F\u0435\u0442 \u0435\u0433\u043E
      \u0441\u043D\u043E\u0432\u0430.\r\n\r\n\u041D\u0430 \u0443\u0440\u043E\u0432\u043D\u0435
      \u0442\u0440\u0438 \u0443\u0437\u043B\u0430. \u0421\u043D\u0430\u0447\u0430\u043B\u0430
      \u043D\u0430\u0439\u0434\u0438 \u0443\u0437\u0435\u043B \u0434\u043E\u0441\u0442\u0443\u043F\u0430
      \u043F\u0440\u043E\u0432\u0430\u0439\u0434\u0435\u0440\u0430 \u2014 \u043E\u043D
      \u0441\u0442\u043E\u0438\u0442 \u0431\u043B\u0438\u0436\u0435 \u043A \u0441\u0442\u0430\u0440\u0442\u0443.
      \u041F\u043E\u0442\u043E\u043C \u043F\u043E\u0434\u043D\u0438\u043C\u0438\u0441\u044C
      \u043A \u0434\u043E\u043C\u043E\u0432\u043E\u043C\u0443 \u043A\u043E\u043C\u043C\u0443\u0442\u0430\u0442\u043E\u0440\u0443
      \u2014 \u043E\u043D \u0440\u0430\u0441\u043F\u0440\u0435\u0434\u0435\u043B\u044F\u0435\u0442
      \u0438\u043D\u0442\u0435\u0440\u043D\u0435\u0442 \u043F\u043E \u044D\u0442\u0430\u0436\u0430\u043C
      \u0437\u0434\u0430\u043D\u0438\u044F. \u0418 \u043D\u0430\u043A\u043E\u043D\u0435\u0446
      \u0434\u043E\u0431\u0435\u0440\u0438\u0441\u044C \u0434\u043E \u043E\u0444\u0438\u0441\u043D\u043E\u0433\u043E
      \u043C\u0430\u0440\u0448\u0440\u0443\u0442\u0438\u0437\u0430\u0442\u043E\u0440\u0430
      \u2014 \u044D\u0442\u043E \u0443\u0436\u0435 \u0432\u0445\u043E\u0434 \u0432
      \u043B\u043E\u043A\u0430\u043B\u044C\u043D\u0443\u044E \u0441\u0435\u0442\u044C.\r\n\r\n\u0421\u043C\u043E\u0442\u0440\u0438
      \u0432\u043D\u0438\u043C\u0430\u0442\u0435\u043B\u044C\u043D\u043E \u043D\u0430
      \u043F\u043E\u043B\u0435 \u043F\u0435\u0440\u0435\u0434 \u0442\u0435\u043C
      \u043A\u0430\u043A \u0437\u0430\u043F\u0443\u0441\u043A\u0430\u0442\u044C \u043A\u043E\u043C\u0430\u043D\u0434\u044B.
      \u041D\u0435 \u0432\u0441\u0435 \u043F\u0443\u0442\u0438 \u043E\u0434\u0438\u043D\u0430\u043A\u043E\u0432\u043E
      \u0431\u0435\u0437\u043E\u043F\u0430\u0441\u043D\u044B."
  charactersRoot: {fileID: 0}
  propsRoot: {fileID: 0}
  targetsRoot: {fileID: 0}
  agent: {fileID: 0}
  targetTransforms: []
  checkpointDescriptions:
  - title: "\u0411\u0430\u0437\u0430 \u0434\u0430\u043D\u043D\u044B\u0445"
    clickBody: "\u0425\u0440\u0430\u043D\u0438\u0442 \u0432\u0441\u044E \u0438\u043D\u0444\u043E\u0440\u043C\u0430\u0446\u0438\u044E
      \u0441\u0438\u0441\u0442\u0435\u043C\u044B. \u041A\u043E\u0433\u0434\u0430
      \u0442\u044B \u0437\u0430\u0445\u043E\u0434\u0438\u0448\u044C \u043D\u0430
      \u0441\u0430\u0439\u0442 \u2014 \u0441\u0435\u0440\u0432\u0435\u0440 \u0441\u043D\u0430\u0447\u0430\u043B\u0430
      \u043E\u0431\u0440\u0430\u0449\u0430\u0435\u0442\u0441\u044F \u0441\u044E\u0434\u0430."
    reachBody: "\u0417\u0430\u043F\u0440\u043E\u0441 \u043F\u0440\u0438\u043D\u044F\u0442!
      \u0411\u0430\u0437\u0430 \u0434\u0430\u043D\u043D\u044B\u0445 \u043D\u0430\u0448\u043B\u0430
      \u043D\u0443\u0436\u043D\u044B\u0435 \u0434\u0430\u043D\u043D\u044B\u0435.
      \u0421\u043B\u0435\u0434\u0443\u044E\u0449\u0438\u0439 \u0443\u0437\u0435\u043B
      \u2014 \u0441\u0435\u0440\u0432\u0435\u0440 \u043F\u0440\u0438\u043B\u043E\u0436\u0435\u043D\u0438\u0439."
  - title: "\u0421\u0435\u0440\u0432\u0435\u0440 \u043F\u0440\u0438\u043B\u043E\u0436\u0435\u043D\u0438\u0439"
    clickBody: "\u041C\u043E\u0437\u0433 \u0441\u0438\u0441\u0442\u0435\u043C\u044B.
      \u041E\u0431\u0440\u0430\u0431\u0430\u0442\u044B\u0432\u0430\u0435\u0442 \u043B\u043E\u0433\u0438\u043A\u0443:
      \u043F\u0440\u043E\u0432\u0435\u0440\u044F\u0435\u0442 \u043F\u0430\u0440\u043E\u043B\u0438,
      \u0444\u043E\u0440\u043C\u0438\u0440\u0443\u0435\u0442 \u043E\u0442\u0432\u0435\u0442\u044B."
    reachBody: "\u0414\u0430\u043D\u043D\u044B\u0435 \u043E\u0431\u0440\u0430\u0431\u043E\u0442\u0430\u043D\u044B!
      \u0421\u0435\u0440\u0432\u0435\u0440 \u0432\u044B\u043F\u043E\u043B\u043D\u0438\u043B
      \u0431\u0438\u0437\u043D\u0435\u0441-\u043B\u043E\u0433\u0438\u043A\u0443 \u0438
      \u043F\u043E\u0434\u0433\u043E\u0442\u043E\u0432\u0438\u043B \u043E\u0442\u0432\u0435\u0442.
      \u041E\u0441\u0442\u0430\u043B\u043E\u0441\u044C \u043F\u0440\u043E\u0439\u0442\u0438
      \u0447\u0435\u0440\u0435\u0437 \u043A\u043E\u043C\u043C\u0443\u0442\u0430\u0442\u043E\u0440."
  - title: "\u0421\u0435\u0440\u0432\u0435\u0440\u043D\u044B\u0439 \u043A\u043E\u043C\u043C\u0443\u0442\u0430\u0442\u043E\u0440"
    clickBody: "\u0421\u043E\u0435\u0434\u0438\u043D\u044F\u0435\u0442 \u0443\u0441\u0442\u0440\u043E\u0439\u0441\u0442\u0432\u0430
      \u0432 \u0434\u0430\u0442\u0430-\u0446\u0435\u043D\u0442\u0440\u0435. \u041E\u0442\u043F\u0440\u0430\u0432\u043B\u044F\u0435\u0442
      \u043F\u0430\u043A\u0435\u0442 \u0442\u043E\u043B\u044C\u043A\u043E \u043D\u0443\u0436\u043D\u043E\u043C\u0443
      \u043F\u043E\u043B\u0443\u0447\u0430\u0442\u0435\u043B\u044E \u043F\u043E MAC-\u0430\u0434\u0440\u0435\u0441\u0443."
    reachBody: "\u0423\u0440\u043E\u0432\u0435\u043D\u044C \u043F\u0440\u043E\u0439\u0434\u0435\u043D!
      \u0422\u044B \u043F\u0440\u043E\u0448\u0451\u043B \u0432\u0435\u0441\u044C
      \u043C\u0430\u0440\u0448\u0440\u0443\u0442: \u0411\u0414 \u2192 \u0421\u0435\u0440\u0432\u0435\u0440
      \u2192 \u041A\u043E\u043C\u043C\u0443\u0442\u0430\u0442\u043E\u0440. \u0422\u0430\u043A
      \u0440\u0430\u0431\u043E\u0442\u0430\u0435\u0442 \u043A\u0430\u0436\u0434\u044B\u0439
      \u0437\u0430\u043F\u0440\u043E\u0441 \u043A \u043B\u044E\u0431\u043E\u043C\u0443
      \u0441\u0430\u0439\u0442\u0443."
