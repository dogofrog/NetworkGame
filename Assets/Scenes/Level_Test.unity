--- !u!114 &1697440868
MonoBehaviour:
  m_ObjectHideFlags: 0
  m_CorrespondingSourceObject: {fileID: 0}
  m_PrefabInstance: {fileID: 0}
  m_PrefabAsset: {fileID: 0}
  m_GameObject: {fileID: 1697440867}
  m_Enabled: 1
  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: 112c05343c1014c7abf5e48d01901320, type: 3}
  m_Name: 
  m_EditorClassIdentifier: 
  grid: {fileID: 460038904}
  characterPrefab: {fileID: 314482583401424754, guid: 2170cc048c05d49418defe5bc8c69e2f, type: 3}
  targetPrefabs:
  - {fileID: 8611203575674866760, guid: 0ab137e6b0f09d346bded5f640552525, type: 3}
  - {fileID: 8611203575674866760, guid: 0ab137e6b0f09d346bded5f640552525, type: 3}
  - {fileID: 8611203575674866760, guid: 0ab137e6b0f09d346bded5f640552525, type: 3}
  targetYOffset: 0.5
  start: {x: 0, y: 0}
  targetCells:
  - {x: 3, y: 3}
  - {x: 5, y: 5}
  - {x: 7, y: 7}
  levelIntro:
    levelId: 0
    title: "\u0423\u0440\u043E\u0432\u0435\u043D\u044C \u2014 \u0421\u0435\u0440\u0432\u0435\u0440\u043D\u0430\u044F
      \u0447\u0430\u0441\u0442\u044C \u0438 \u0434\u0430\u0442\u0430-\u0446\u0435\u043D\u0442\u0440 "
    body: "\u041D\u0430 \u044D\u0442\u043E\u043C \u0443\u0440\u043E\u0432\u043D\u0435
      \u0442\u044B \u043F\u0440\u043E\u0445\u043E\u0434\u0438\u0448\u044C \u043F\u0443\u0442\u044C
      \u043F\u0430\u043A\u0435\u0442\u0430 \u0434\u0430\u043D\u043D\u044B\u0445 \u0432\u043D\u0443\u0442\u0440\u0438
      \u0441\u0435\u0440\u0432\u0435\u0440\u043D\u043E\u0439 \u0447\u0430\u0441\u0442\u0438.\n\n\u0422\u0435\u0431\u0435
      \u043D\u0443\u0436\u043D\u043E \u0434\u043E\u0439\u0442\u0438 \u0434\u043E
      \u043E\u0431\u044A\u0435\u043A\u0442\u043E\u0432 \u0432 \u0442\u0430\u043A\u043E\u043C
      \u043F\u043E\u0440\u044F\u0434\u043A\u0435:\n\n1. \u0411\u0430\u0437\u0430
      \u0434\u0430\u043D\u043D\u044B\u0445 (Database Server)\n\u0417\u0434\u0435\u0441\u044C
      \u0445\u0440\u0430\u043D\u044F\u0442\u0441\u044F \u0434\u0430\u043D\u043D\u044B\u0435:
      \u0442\u0430\u0431\u043B\u0438\u0446\u044B, \u0437\u0430\u043F\u0438\u0441\u0438,
      \u0444\u0430\u0439\u043B\u044B \u0438 \u0438\u043D\u0444\u043E\u0440\u043C\u0430\u0446\u0438\u044F,
      \u0441 \u043A\u043E\u0442\u043E\u0440\u043E\u0439 \u0440\u0430\u0431\u043E\u0442\u0430\u0435\u0442
      \u0441\u0435\u0440\u0432\u0438\u0441.\n\n2. \u0421\u0435\u0440\u0432\u0435\u0440
      \u043F\u0440\u0438\u043B\u043E\u0436\u0435\u043D\u0438\u0439 (Application Server)\n\u0417\u0434\u0435\u0441\u044C
      \u043E\u0431\u0440\u0430\u0431\u0430\u0442\u044B\u0432\u0430\u0435\u0442\u0441\u044F
      \u0437\u0430\u043F\u0440\u043E\u0441, \u0432\u044B\u043F\u043E\u043B\u043D\u044F\u0435\u0442\u0441\u044F
      \u043B\u043E\u0433\u0438\u043A\u0430 \u043F\u0440\u0438\u043B\u043E\u0436\u0435\u043D\u0438\u044F
      \u0438 \u0444\u043E\u0440\u043C\u0438\u0440\u0443\u0435\u0442\u0441\u044F \u043E\u0442\u0432\u0435\u0442
      \u0434\u043B\u044F \u043F\u043E\u043B\u044C\u0437\u043E\u0432\u0430\u0442\u0435\u043B\u044F.\n\n3.
      \u0421\u0435\u0440\u0432\u0435\u0440\u043D\u044B\u0439 \u043A\u043E\u043C\u043C\u0443\u0442\u0430\u0442\u043E\u0440
      (Top-of-Rack Switch)\n\u041E\u043D \u0441\u043E\u0435\u0434\u0438\u043D\u044F\u0435\u0442
      \u0441\u0435\u0440\u0432\u0435\u0440\u044B \u0432\u043D\u0443\u0442\u0440\u0438
      \u0441\u0442\u043E\u0439\u043A\u0438 \u0438\u043B\u0438 \u0434\u0430\u0442\u0430-\u0446\u0435\u043D\u0442\u0440\u0430
      \u0438 \u043F\u0435\u0440\u0435\u0434\u0430\u0435\u0442 \u0442\u0440\u0430\u0444\u0438\u043A
      \u0434\u0430\u043B\u044C\u0448\u0435 \u043F\u043E \u0441\u0435\u0442\u0438.\n\n\u041F\u043E\u0440\u044F\u0434\u043E\u043A
      \u043F\u0440\u043E\u0445\u043E\u0436\u0434\u0435\u043D\u0438\u044F \u0432\u0430\u0436\u0435\u043D,
      \u043F\u043E\u0442\u043E\u043C\u0443 \u0447\u0442\u043E \u0432 \u0440\u0435\u0430\u043B\u044C\u043D\u043E\u0439
      \u0441\u0435\u0442\u0438 \u0434\u0430\u043D\u043D\u044B\u0435 \u0441\u043D\u0430\u0447\u0430\u043B\u0430
      \u0431\u0435\u0440\u0443\u0442\u0441\u044F \u0438\u0437 \u0445\u0440\u0430\u043D\u0438\u043B\u0438\u0449\u0430,
      \u0437\u0430\u0442\u0435\u043C \u043E\u0431\u0440\u0430\u0431\u0430\u0442\u044B\u0432\u0430\u044E\u0442\u0441\u044F
      \u0441\u0435\u0440\u0432\u0435\u0440\u043E\u043C \u043F\u0440\u0438\u043B\u043E\u0436\u0435\u043D\u0438\u044F,
      \u0438 \u0442\u043E\u043B\u044C\u043A\u043E \u043F\u043E\u0442\u043E\u043C
      \u043F\u0435\u0440\u0435\u0434\u0430\u044E\u0442\u0441\u044F \u0447\u0435\u0440\u0435\u0437
      \u0441\u0435\u0442\u0435\u0432\u043E\u0435 \u043E\u0431\u043E\u0440\u0443\u0434\u043E\u0432\u0430\u043D\u0438\u0435
      \u0434\u0430\u043B\u044C\u0448\u0435.\n\n\u0413\u043B\u0430\u0432\u043D\u0430\u044F
      \u0438\u0434\u0435\u044F \u0443\u0440\u043E\u0432\u043D\u044F:\n\u0432 \u0441\u0435\u0440\u0432\u0435\u0440\u043D\u043E\u0439
      \u0434\u0430\u043D\u043D\u044B\u0435 \u043D\u0435 \u043F\u0435\u0440\u0435\u043C\u0435\u0449\u0430\u044E\u0442\u0441\u044F
      \u043D\u0430\u043F\u0440\u044F\u043C\u0443\u044E \u043C\u0435\u0436\u0434\u0443
      \u0432\u0441\u0435\u043C\u0438 \u0443\u0441\u0442\u0440\u043E\u0439\u0441\u0442\u0432\u0430\u043C\u0438.
      \u0414\u043B\u044F \u043F\u0435\u0440\u0435\u0434\u0430\u0447\u0438 \u0438\u0441\u043F\u043E\u043B\u044C\u0437\u0443\u044E\u0442\u0441\u044F
      \u043A\u043E\u043C\u043C\u0443\u0442\u0430\u0442\u043E\u0440\u044B, \u0430
      \u0441\u0435\u0440\u0432\u0435\u0440\u044B \u0432\u044B\u043F\u043E\u043B\u043D\u044F\u044E\u0442
      \u0440\u0430\u0437\u043D\u044B\u0435 \u0440\u043E\u043B\u0438: \u043E\u0434\u043D\u0438
      \u0445\u0440\u0430\u043D\u044F\u0442 \u0434\u0430\u043D\u043D\u044B\u0435,
      \u0434\u0440\u0443\u0433\u0438\u0435 \u043E\u0431\u0440\u0430\u0431\u0430\u0442\u044B\u0432\u0430\u044E\u0442
      \u0437\u0430\u043F\u0440\u043E\u0441\u044B.\n"
  charactersRoot: {fileID: 0}
  propsRoot: {fileID: 0}
  targetsRoot: {fileID: 0}
  agent: {fileID: 0}
  targetTransforms: []
  checkpointDescriptions:
  - title: "\u0411\u0430\u0437\u0430 \u0434\u0430\u043D\u043D\u044B\u0445"
    clickBody: "\u0425\u0440\u0430\u043D\u0438\u0442 \u0432\u0441\u044E \u0438\u043D\u0444\u043E\u0440\u043C\u0430\u0446\u0438\u044E
      \u0441\u0438\u0441\u0442\u0435\u043C\u044B. \u041A\u043E\u0433\u0434\u0430
      \u0442\u044B \u0437\u0430\u0445\u043E\u0434\u0438\u0448\u044C \u043D\u0430
      \u0441\u0430\u0439\u0442 \u2014 \u0441\u0435\u0440\u0432\u0435\u0440 \u0441\u043D\u0430\u0447\u0430\u043B\u0430
      \u043E\u0431\u0440\u0430\u0449\u0430\u0435\u0442\u0441\u044F \u0441\u044E\u0434\u0430."
    reachBody: "\u0417\u0430\u043F\u0440\u043E\u0441 \u043F\u0440\u0438\u043D\u044F\u0442!
      \u0411\u0430\u0437\u0430 \u0434\u0430\u043D\u043D\u044B\u0445 \u043D\u0430\u0448\u043B\u0430
      \u043D\u0443\u0436\u043D\u044B\u0435 \u0434\u0430\u043D\u043D\u044B\u0435.
      \u0421\u043B\u0435\u0434\u0443\u044E\u0449\u0438\u0439 \u0443\u0437\u0435\u043B
      \u2014 \u0441\u0435\u0440\u0432\u0435\u0440 \u043F\u0440\u0438\u043B\u043E\u0436\u0435\u043D\u0438\u0439."
  - title: "\u0421\u0435\u0440\u0432\u0435\u0440 \u043F\u0440\u0438\u043B\u043E\u0436\u0435\u043D\u0438\u0439"
    clickBody: "\u041C\u043E\u0437\u0433 \u0441\u0438\u0441\u0442\u0435\u043C\u044B.
      \u041E\u0431\u0440\u0430\u0431\u0430\u0442\u044B\u0432\u0430\u0435\u0442 \u043B\u043E\u0433\u0438\u043A\u0443:
      \u043F\u0440\u043E\u0432\u0435\u0440\u044F\u0435\u0442 \u043F\u0430\u0440\u043E\u043B\u0438,
      \u0444\u043E\u0440\u043C\u0438\u0440\u0443\u0435\u0442 \u043E\u0442\u0432\u0435\u0442\u044B."
    reachBody: "\u0414\u0430\u043D\u043D\u044B\u0435 \u043E\u0431\u0440\u0430\u0431\u043E\u0442\u0430\u043D\u044B!
      \u0421\u0435\u0440\u0432\u0435\u0440 \u0432\u044B\u043F\u043E\u043B\u043D\u0438\u043B
      \u0431\u0438\u0437\u043D\u0435\u0441-\u043B\u043E\u0433\u0438\u043A\u0443 \u0438
      \u043F\u043E\u0434\u0433\u043E\u0442\u043E\u0432\u0438\u043B \u043E\u0442\u0432\u0435\u0442.
      \u041E\u0441\u0442\u0430\u043B\u043E\u0441\u044C \u043F\u0440\u043E\u0439\u0442\u0438
      \u0447\u0435\u0440\u0435\u0437 \u043A\u043E\u043C\u043C\u0443\u0442\u0430\u0442\u043E\u0440."
  - title: "\u0421\u0435\u0440\u0432\u0435\u0440\u043D\u044B\u0439 \u043A\u043E\u043C\u043C\u0443\u0442\u0430\u0442\u043E\u0440"
    clickBody: "\u0421\u043E\u0435\u0434\u0438\u043D\u044F\u0435\u0442 \u0443\u0441\u0442\u0440\u043E\u0439\u0441\u0442\u0432\u0430
      \u0432 \u0434\u0430\u0442\u0430-\u0446\u0435\u043D\u0442\u0440\u0435. \u041E\u0442\u043F\u0440\u0430\u0432\u043B\u044F\u0435\u0442
      \u043F\u0430\u043A\u0435\u0442 \u0442\u043E\u043B\u044C\u043A\u043E \u043D\u0443\u0436\u043D\u043E\u043C\u0443
      \u043F\u043E\u043B\u0443\u0447\u0430\u0442\u0435\u043B\u044E \u043F\u043E MAC-\u0430\u0434\u0440\u0435\u0441\u0443."
    reachBody: "\u0423\u0440\u043E\u0432\u0435\u043D\u044C \u043F\u0440\u043E\u0439\u0434\u0435\u043D!
      \u0422\u044B \u043F\u0440\u043E\u0448\u0451\u043B \u0432\u0435\u0441\u044C
      \u043C\u0430\u0440\u0448\u0440\u0443\u0442: \u0411\u0414 \u2192 \u0421\u0435\u0440\u0432\u0435\u0440
      \u2192 \u041A\u043E\u043C\u043C\u0443\u0442\u0430\u0442\u043E\u0440. \u0422\u0430\u043A
      \u0440\u0430\u0431\u043E\u0442\u0430\u0435\u0442 \u043A\u0430\u0436\u0434\u044B\u0439
      \u0437\u0430\u043F\u0440\u043E\u0441 \u043A \u043B\u044E\u0431\u043E\u043C\u0443
      \u0441\u0430\u0439\u0442\u0443."
